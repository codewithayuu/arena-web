# Copy to .env.local and provide values from your own services.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase (server only; never expose the service role key with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Neon (server only)
NEON_DATABASE_URL=

# Platform ownership verification (at least 32 random characters)
PLATFORM_VERIFICATION_SECRET=

# Vercel scheduled Render profile-sync service
CRON_SECRET=
RENDER_PROFILE_SERVICE_URL=
PROFILE_SYNC_SERVICE_SECRET=
# Optional fine-grained GitHub token for higher public API limits (Render profile service only)
GITHUB_TOKEN=

# Optional contest gateway
MINDFLARE_GATEWAY_ORIGIN=
NEXT_PUBLIC_MINDFLARE_GATEWAY_ORIGIN=

# Server-only replay proxy to the Deadlock control API
DEADLOCK_API_BASE_URL=

# Server-only Ed25519 signing key for public local-practice execution packs.
# Keep the private 32-byte seed in the deployment secret store, never in NEXT_PUBLIC_*.
MINDFLARE_PRACTICE_PACK_SIGNER_KEY_ID=
MINDFLARE_PRACTICE_PACK_SIGNER_PRIVATE_SEED_BASE64=
