{
  "name": "@mindflare/web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run prepare:monaco && next dev",
    "build": "bun run prepare:monaco && next build",
    "prepare:monaco": "node scripts/prepare-monaco-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:company-problem-ids": "bun scripts/generate-company-problem-ids.mjs",
    "test:practice-runner": "bun test lib/practice-run-adapters.test.ts",
    "test:practice-packs": "bun test lib/practice-test-bundle.test.ts",
    "test:runtime-bridge": "bun test lib/runtime-bridge.test.ts",
    "test:monaco-assets": "bun test lib/monaco-loader.test.ts && node --test scripts/prepare-monaco-assets.test.mjs",
    "test:contest-drafts": "bun test lib/contest-drafts.test.ts",
    "test:contest-clock": "bun test lib/contest-clock.test.ts",
    "test:contest-submissions": "bun test lib/contest-submissions.test.ts",
    "test:contest-launch-intent": "bun test lib/contest-launch-intent.test.ts",
    "test:contest-statement": "bun test components/contest/contest-statement.test.tsx",
    "test:seb-handoff": "node --test ../../scripts/tests/seb_handoff/*.test.cjs"
  },
