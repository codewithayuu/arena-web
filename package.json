    "@tabler/icons-react": "3.49.0",
    "@types/adm-zip": "0.6.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/three": "0.186.0",
    "@uiw/react-heat-map": "2.3.4",
    "adm-zip": "0.6.1",
